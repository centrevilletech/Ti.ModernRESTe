{
  "name": "@centrevilletech/reste",
  "version": "2.0.0",
  "description": "A REST / API helper for Titanium with Alloy models and collections. A maintained fork of RESTe by Jason Kneen: promises, retries, caching, pagination, uploads, scoped sync.",
  "main": "reste.js",
  "types": "reste.d.ts",
  "files": [
    "reste.js",
    "split/",
    "reste.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "test": "node scripts/build.js && node --test \"test/unit/*.test.js\" \"test/integration/*.test.js\" && RESTE_ENTRY=bundle node --test \"test/unit/*.test.js\" \"test/integration/*.test.js\" && RESTE_ENTRY=split node --test \"test/unit/*.test.js\" \"test/integration/*.test.js\"",
    "test:src": "node --test \"test/unit/*.test.js\" \"test/integration/*.test.js\"",
    "types": "tsc -p test/types",
    "bench": "node --expose-gc bench/run.js",
    "server": "node test/server/server.js",
    "mutate": "node scripts/mutate.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centrevilletech/Ti.ModernRESTe.git"
  },
  "keywords": [
    "alloy",
    "api",
    "backbone",
    "rest",
    "http",
    "titanium",
    "titanium-module",
    "titanium-sdk"
  ],
  "author": {
    "name": "Jason Kneen",
    "url": "https://github.com/jasonkneen"
  },
  "contributors": [
    {
      "name": "Centreville Tech LLC",
      "url": "https://github.com/centrevilletech"
    }
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/centrevilletech/Ti.ModernRESTe/issues"
  },
  "homepage": "https://github.com/centrevilletech/Ti.ModernRESTe#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "backbone-0.9.2": "npm:backbone@0.9.2",
    "backbone-1.1.2": "npm:backbone@1.1.2",
    "backbone-1.3.3": "npm:backbone@1.3.3",
    "backbone-1.4.0": "npm:backbone@1.4.0",
    "backbone-1.6.0": "npm:backbone@1.6.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "typescript": "^5.6.3",
    "underscore": "1.13.6"
  },
  "maintainers": [
    {
      "name": "Centreville Tech LLC",
      "url": "https://github.com/centrevilletech"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
